(function(){var min=10000,max=25000,curr=Math.floor(Math.random()*(max-min+1)+min);setInterval(function(){var d=Math.floor(Math.random()*201)-100;var n=curr+d;if(n<min)n=min;if(n>max)n=max;curr=n;var e=document.getElementById('liveCount');if(e)e.innerText=curr.toLocaleString();},10000);var d=document.createElement('div');d.style.cssText='position:fixed;bottom:20px;right:20px;z-index:9999;background:radial-gradient(circle,#ffcc00,#ff6600);border-radius:50%;width:140px;height:140px;display:flex;align-items:center;justify-content:center;flex-direction:column;box-shadow:0 0 30px orange;cursor:pointer;';d.innerHTML='<div style="font-size:28px;">👥</div><div id="liveCount" style="font-size:24px;font-weight:bold;">'+curr.toLocaleString()+'</div><div style="font-size:10px;">LIVE NOW</div>';document.body.appendChild(d);})();
